#!/bin/bash
# Runs before every commit, so patient data or a site path is stopped before it enters the
# history. (CI runs the same scan, but only after a push, when it is already public.)
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypassing it (`git commit --no-verify`) defeats its purpose; don't, for this repository.

root=$(git rev-parse --show-toplevel)

bash "$root/scripts/check_identifiers.sh" --staged || exit 1

# Lint the staged Python files, if ruff is installed (CI enforces it either way).
py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$py" ]; then
  if command -v ruff >/dev/null 2>&1; then
    (cd "$root" && echo "$py" | xargs ruff check) || exit 1
  else
    echo "pre-commit: ruff not installed, skipping lint (pip install -e '.[dev]')"
  fi
fi
